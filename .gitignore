# Entornos, cachés, archivos personales y credenciales.
.venv/
.venv-ml/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.runtime/
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
Thumbs.db
.DS_Store
/tmp/
*.running.lock
.attempts/
*.log
*.zip

# Solo la identificación del modelo: PREPARAR_IA.ps1 descarga y verifica los pesos.
/models/*
!/models/manifest.json
!/models/spacenet2_khartoum_v1/
/models/spacenet2_khartoum_v1/*
!/models/spacenet2_khartoum_v1/weights.pth
!/models/spacenet2_khartoum_v1/*.json
!/models/spacenet2_khartoum_v1/LICENSE_AND_ATTRIBUTION.txt
!/models/chullo_local_v1/
/models/chullo_local_v1/*
!/models/chullo_local_v1/weights.pth
!/models/chullo_local_v1/*.json
!/models/chullo_local_v1/LICENSE_AND_ATTRIBUTION.txt

# Datos mínimos del prototipo; originales y cargas de usuario permanecen locales.
/data/*
!/data/sources.json
!/data/processed/
!/data/imagery/
!/data/training/
/data/training/*
!/data/training/chullo_local_v1/
/data/training/chullo_local_v1/*
!/data/training/chullo_local_v1/selection.json
!/data/training/chullo_local_v1/manifest.json
!/data/training/chullo_local_v1/*.pixels.json
!/data/training/chullo_local_v1/*.geojson
# Recortes preliminares de un área excluida antes del entrenamiento final.
/data/training/chullo_local_v1/train_1100_500_chip_*
!/data/training/chullo_local_v2/
/data/training/chullo_local_v2/*
!/data/training/chullo_local_v2/*.json
!/data/training/chullo_local_v2/*.geojson
